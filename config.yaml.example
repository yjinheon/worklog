version: 3

# Project names are derived from repo folder names.
# Example: ~/workspace/local-flow -> project name "local-flow".
#
# `project_groups` is metadata for later rollups only. Do not use group names
# as worklog project headings or #project tags.
project_groups:
  data-engineering:
    description: Data pipelines, orchestration, ingestion, and warehouse work
  personal-kms:
    description: Personal knowledge management, blog, notes, and automation
  learning:
    description: Study projects and playground repositories

repos:
  - path: ~/workspace/data-pipeline
    description: Batch and streaming data pipeline implementation
    group: data-engineering

  - path: ~/workspace/astro-blog
    description: Obsidian-backed personal blog and knowledge base
    group: personal-kms

task_tags: [feat, fix, refactor, perf, docs, test, chore, build, ci, style, revert]
system_tags: [elasticsearch, clickhouse, dagster, airflow, kafka, dbt, kubernetes, redis]

# Jira completion CSV exporter. Set the token through JIRA_API_TOKEN.
JIRA_BASE_URL: https://example.atlassian.net
JIRA_EMAIL: user@example.com

# Jira issue creation (jira_create.py). Set the token through JIRA_API_TOKEN.
# epic_map keys accept a group name or a project name; project wins over group.
# Values accept an epic key, an epic name (substring match), or null to exclude.
JIRA_PROJECT_KEY: DC
worklog_dir: worklogs
# Lines carrying only these task tags are bookkeeping, not a unit of work.
skip_tags: [chore, style, ci]

# 기본 계층은 Epic > Task > 하위 작업 3단계다.
# 한 프로젝트+에픽 묶음이 이 수 이상이면 묶음 Task를 만들어 그 아래 하위 작업으로
# 생성하고, 그보다 적으면 평범한 Task로 승격한다.
min_group: 2
epic_map:
  data-engineering: DC-100
  personal-kms: null
